# Supabase — from your project's API settings
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...

# Server-only: used by the inbound email webhook to write entries
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...

# Shared secret the inbound email provider must send with each webhook call
INBOUND_WEBHOOK_SECRET=change-me
